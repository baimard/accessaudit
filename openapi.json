        "/api/users/{uid}/folders": {
            "get": {
                "operationId": "userFolders",
                "summary": "User folders",
                "parameters": [
                    {
                        "name": "uid",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Success",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "required": [
                                        "folders",
                                        "complete",
                                        "unavailable"
                                    ],
                                    "properties": {
                                        "folders": {
                                            "type": "array",
                                            "items": {
                                                "type": "string"
                                            }
                                        },
                                        "complete": {
                                            "type": "boolean",
                                            "description": "False on storage errors, scan limit (10000 folders) or time limit (10 seconds between storage operations)."
                                        },
                                        "unavailable": {
                                            "type": "array",
                                            "items": {
                                                "type": "string"
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Invalid export column"
                    },
                    "401": {
                        "description": "Authentication required (browser requests may redirect to login)"
                    },
                    "403": {
                        "description": "Application access denied for this user"
