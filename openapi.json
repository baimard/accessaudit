        "/api/export/users": {
            "get": {
                "operationId": "exportUsers",
                "summary": "Export users",
                "parameters": [
                    {
                        "name": "format",
                        "in": "query",
                        "schema": {
                            "type": "string",
                            "enum": [
                                "csv",
                                "json"
                            ],
                            "default": "csv"
                        }
                    },
                    {
                        "name": "columns[]",
                        "in": "query",
                        "style": "form",
                        "explode": true,
                        "description": "CSV column keys in desired order; omit for all standard fields. Users may additionally select folders. Incomplete folder inventories return 503. JSON retains all fields.",
                        "schema": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Success",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "additionalProperties": true
                                }
                            },
                            "text/csv": {
                                "schema": {
                                    "type": "string"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Invalid export column"
                    },
                    "401": {
                        "description": "Authentication required (browser requests may redirect to login)"
