{
    "openapi": "3.0.3",
    "info": {
        "title": "Nextcloud Access Audit",
        "version": "0.0.12",
        "description": "Read-only audit. All routes require authentication and app access according to the Nextcloud application activation groups. Folder paths are relative to the audited user files root, including mounted shares and available external storage.",
        "license": {
            "name": "AGPL-3.0-or-later"
        }
    },
    "servers": [
        {
            "url": "/index.php/apps/accessaudit"
        }
    ],
    "security": [
        {
            "basic_auth": []
        }
    ],
    "components": {
        "securitySchemes": {
            "basic_auth": {
                "type": "http",
                "scheme": "basic"
            }
        }
    },
    "paths": {
        "/": {
            "get": {
                "operationId": "pageIndex",
                "summary": "Page index",
                "parameters": [],
                "responses": {
                    "200": {
                        "description": "Success",
                        "content": {
                            "text/html": {
                                "schema": {
                                    "type": "string"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Invalid export column"
                    },
                    "401": {
                        "description": "Authentication required (browser requests may redirect to login)"
                    },
                    "403": {
                        "description": "Application access denied for this user"
                    },
                    "404": {
                        "description": "User, group or share not found"
                    },
                    "503": {
                        "description": "Requested folder export is incomplete"
                    }
                }
            }
        },
